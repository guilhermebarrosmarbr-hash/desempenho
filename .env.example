# ==============================================================================
# CONFIGURAÇÃO SUPABASE — BPO FINANCEIRO
# ==============================================================================
# Copie este arquivo para .env.local ou configure diretamente na tela de Configurações
# do módulo financeiro em financeiro/config.html

# URL do seu projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública (Project Settings > API > Project API Keys > anon / public)
# Pode ser usada com segurança no frontend
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço privada (Project Settings > API > Project API Keys > service_role)
# NUNCA exponha no frontend; use apenas em funções serverless / backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# SERVIDOR MEI (MÓDULO 02)
# ==============================================================================
PORT=3000
NODE_ENV=development
